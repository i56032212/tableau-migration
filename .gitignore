# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
# 檢視器的建置結果要進版控，沒有 Node 的電腦也能直接 tmig serve
!web/dist/
.pytest_cache/
.ruff_cache/

# Node
node_modules/

# 由 .hyper 轉出的 DuckDB 檔可隨時重建，不進版控
*.duckdb
*.duckdb.wal

# 編輯器與系統
.vscode/
.idea/
.DS_Store
Thumbs.db

# tmig verify 的差異報告每次重跑都會更新
fixtures/*/report/
fixtures/*/compare/

# tools/tableau_server 的盤點輸出（含從 Tableau Server 下載的報表結構）
/inventory/

# 查詢服務的使用紀錄（tmig serve 預設寫在報表目錄旁的 usage/）
/usage/

# 桌面版：PyInstaller 的打包結果、Tauri 的建置結果與自動產生的權限 schema
desktop/engine/dist/
desktop/engine/build/
desktop/src-tauri/target/
desktop/src-tauri/gen/
desktop/src-tauri/permissions/autogenerated/

# scripts/check_commit.py 的工作目錄
.worktrees/

# 伺服器版的 Windows 安裝檔：服務主程式的建置結果、組好的資料夾與安裝檔（deploy/windows/build/ 由上面的 build/ 排除）
deploy/windows/host/target/
