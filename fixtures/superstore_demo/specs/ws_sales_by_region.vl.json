{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "usermeta": {
    "worksheet": "ws_sales_by_region",
    "name": "Sales by Region",
    "rows": 6,
    "mark": "bar",
    "dimensions": {
      "c0": "f_region",
      "c1": "f_category"
    },
    "measures": {
      "c2": "sum(f_sales)",
      "c3": "sum(f_sales)#tc_running_total_sales"
    },
    "sizing": {
      "rows": {
        "step": 20
      },
      "columns": {}
    },
    "fit": "standard"
  },
  "data": {
    "values": "6 列",
    "fields": [
      "__row",
      "c0",
      "c0_label",
      "c1",
      "c1_label",
      "c2",
      "c2_label",
      "c3",
      "c3_label"
    ]
  },
  "width": "container",
  "height": {
    "step": 20
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelLimit": 160
    }
  },
  "encoding": {
    "x": {
      "field": "c2",
      "type": "quantitative",
      "title": "Sales"
    },
    "y": {
      "field": "c0_label",
      "type": "ordinal",
      "sort": null,
      "title": "Region"
    },
    "color": {
      "field": "c1_label",
      "type": "nominal",
      "title": "Category",
      "sort": null,
      "scale": {
        "domain": [
          "Furniture",
          "Technology"
        ],
        "range": [
          "#4e79a7",
          "#f28e2b"
        ]
      }
    },
    "tooltip": [
      {
        "field": "c0_label",
        "title": "Region"
      },
      {
        "field": "c1_label",
        "title": "Category"
      },
      {
        "field": "c2_label",
        "title": "Sales"
      },
      {
        "field": "c3_label",
        "title": "Sales（累計）"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "tooltip": true
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 10,
        "lineBreak": "\n",
        "align": "right",
        "dx": -3
      },
      "encoding": {
        "text": {
          "field": "c2_label"
        },
        "color": {
          "value": "#ffffff"
        },
        "x": {
          "field": "c2",
          "type": "quantitative",
          "title": "Sales",
          "stack": "zero"
        },
        "detail": {
          "field": "c1_label",
          "type": "nominal"
        }
      }
    }
  ]
}
