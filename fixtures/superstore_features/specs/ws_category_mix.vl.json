{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "usermeta": {
    "worksheet": "ws_category_mix",
    "name": "Category Mix",
    "rows": 3,
    "mark": "pie",
    "dimensions": {
      "c0": "f_category"
    },
    "measures": {
      "c1": "sum(f_sales)",
      "c2": "sum(f_sales)#tc_percent_of_total_sales"
    },
    "title_color": "#333333",
    "title_font": {
      "family": "\"Tableau Book\", \"Benton Sans\", \"Segoe UI\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
      "size": 20.0,
      "weight": 400,
      "italic": false
    },
    "sizing": {
      "rows": {},
      "columns": {}
    },
    "fit": "standard"
  },
  "data": {
    "values": "3 列",
    "fields": [
      "__row",
      "c0",
      "c0_label",
      "c1",
      "c1_label",
      "c2",
      "c2_label"
    ]
  },
  "width": "container",
  "height": "container",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "font": "\"Tableau Book\", \"Benton Sans\", \"Segoe UI\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelLimit": 160,
      "labelFont": "\"Tableau Book\", \"Benton Sans\", \"Segoe UI\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
      "labelFontSize": 12.0,
      "labelFontWeight": 400,
      "titleFont": "\"Tableau Book\", \"Benton Sans\", \"Segoe UI\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
      "titleFontSize": 12.0,
      "titleFontWeight": 400,
      "labelColor": "#555555",
      "titleColor": "#333333",
      "gridColor": "#f0f0f0",
      "domainColor": "#f4f4f4",
      "tickColor": "#f4f4f4"
    },
    "legend": {
      "labelFont": "\"Tableau Book\", \"Benton Sans\", \"Segoe UI\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
      "labelFontSize": 12.0,
      "labelFontWeight": 400,
      "titleFont": "\"Tableau Book\", \"Benton Sans\", \"Segoe UI\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
      "titleFontSize": 12.0,
      "titleFontWeight": 600,
      "labelColor": "#555555",
      "titleColor": "#333333"
    },
    "header": {
      "labelFont": "\"Tableau Book\", \"Benton Sans\", \"Segoe UI\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
      "labelFontSize": 12.0,
      "labelFontWeight": 400,
      "titleFont": "\"Tableau Book\", \"Benton Sans\", \"Segoe UI\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
      "titleFontSize": 12.0,
      "titleFontWeight": 400,
      "labelColor": "#555555",
      "titleColor": "#333333"
    },
    "text": {
      "font": "\"Tableau Book\", \"Benton Sans\", \"Segoe UI\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
      "fontSize": 12.0
    }
  },
  "encoding": {
    "theta": {
      "field": "c1",
      "type": "quantitative",
      "stack": true
    },
    "color": {
      "field": "c0_label",
      "type": "nominal",
      "title": "Category",
      "sort": null,
      "scale": {
        "domain": [
          "Furniture",
          "Office Supplies",
          "Technology"
        ],
        "range": [
          "#4e79a7",
          "#f28e2b",
          "#e15759"
        ]
      }
    },
    "tooltip": [
      {
        "field": "c0_label",
        "title": "Category"
      },
      {
        "field": "c1_label",
        "title": "Sales"
      },
      {
        "field": "c2_label",
        "title": "Sales（合計百分比）"
      }
    ],
    "order": {
      "field": "__row"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "arc",
        "tooltip": true,
        "outerRadius": {
          "expr": "min(width, height) * 0.25"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "font": "\"Tableau Book\", \"Benton Sans\", \"Segoe UI\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
        "fontSize": 12.0,
        "lineBreak": "\n",
        "radius": {
          "expr": "min(width, height) * 0.25 + 24"
        }
      },
      "encoding": {
        "text": {
          "field": "__pie_label"
        },
        "color": {
          "value": "#1f2328"
        },
        "theta": {
          "field": "c1",
          "type": "quantitative",
          "stack": true
        },
        "order": {
          "field": "__row"
        }
      },
      "transform": [
        {
          "calculate": "datum['c0_label'] + '\\n' + datum['c2_label']",
          "as": "__pie_label"
        }
      ]
    }
  ]
}
