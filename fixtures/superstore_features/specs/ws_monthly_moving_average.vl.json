{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "usermeta": {
    "worksheet": "ws_monthly_moving_average",
    "name": "Monthly Moving Average",
    "rows": 48,
    "mark": "line",
    "dimensions": {
      "c0": "trunc_month(f_order_date)"
    },
    "measures": {
      "c1": "sum(f_sales)#tc_moving_sales",
      "c2": "sum(f_sales)",
      "c3": "sum(f_sales)#tc_moving_sales_2"
    },
    "title_color": "#333333",
    "title_font": {
      "family": "\"Tableau Book\", \"Benton Sans\", \"Segoe UI\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
      "size": 20.0,
      "weight": 400,
      "italic": false
    },
    "sizing": {
      "rows": {},
      "columns": {}
    },
    "fit": "standard"
  },
  "data": {
    "values": "48 列",
    "fields": [
      "__row",
      "c0",
      "c0_label",
      "c1",
      "c1_label",
      "c2",
      "c2_label",
      "c3",
      "c3_label"
    ]
  },
  "width": "container",
  "height": "container",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "font": "\"Tableau Book\", \"Benton Sans\", \"Segoe UI\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelLimit": 160,
      "labelFont": "\"Tableau Book\", \"Benton Sans\", \"Segoe UI\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
      "labelFontSize": 12.0,
      "labelFontWeight": 400,
      "titleFont": "\"Tableau Book\", \"Benton Sans\", \"Segoe UI\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
      "titleFontSize": 12.0,
      "titleFontWeight": 400,
      "labelColor": "#555555",
      "titleColor": "#333333",
      "gridColor": "#f0f0f0",
      "domainColor": "#f4f4f4",
      "tickColor": "#f4f4f4"
    },
    "legend": {
      "labelFont": "\"Tableau Book\", \"Benton Sans\", \"Segoe UI\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
      "labelFontSize": 12.0,
      "labelFontWeight": 400,
      "titleFont": "\"Tableau Book\", \"Benton Sans\", \"Segoe UI\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
      "titleFontSize": 12.0,
      "titleFontWeight": 600,
      "labelColor": "#555555",
      "titleColor": "#333333"
    },
    "header": {
      "labelFont": "\"Tableau Book\", \"Benton Sans\", \"Segoe UI\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
      "labelFontSize": 12.0,
      "labelFontWeight": 400,
      "titleFont": "\"Tableau Book\", \"Benton Sans\", \"Segoe UI\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
      "titleFontSize": 12.0,
      "titleFontWeight": 400,
      "labelColor": "#555555",
      "titleColor": "#333333"
    },
    "text": {
      "font": "\"Tableau Book\", \"Benton Sans\", \"Segoe UI\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
      "fontSize": 12.0
    }
  },
  "mark": {
    "type": "line",
    "tooltip": true,
    "point": "transparent",
    "clip": true,
    "color": "#4e79a7",
    "strokeWidth": 2,
    "strokeCap": "round",
    "strokeJoin": "round"
  },
  "encoding": {
    "y": {
      "field": "c1",
      "type": "quantitative",
      "title": "Sales（移動平均）",
      "axis": {
        "grid": true,
        "gridColor": {
          "condition": {
            "test": "datum.value === 0",
            "value": "#cbcbcb"
          },
          "value": "#f0f0f0"
        },
        "gridDash": {
          "condition": {
            "test": "datum.value === 0",
            "value": [
              2,
              1
            ]
          },
          "value": []
        },
        "gridWidth": {
          "condition": {
            "test": "datum.value === 0",
            "value": 1
          },
          "value": 1
        },
        "tickCount": {
          "expr": "ceil(height / 50)"
        }
      }
    },
    "x": {
      "field": "c0",
      "type": "temporal",
      "timeUnit": "utcyearmonth",
      "title": "MONTH(Order Date)",
      "scale": {
        "domain": [
          1603281600000.0,
          1739188800000.0
        ],
        "nice": false
      }
    },
    "tooltip": [
      {
        "field": "c0_label",
        "title": "MONTH(Order Date)"
      },
      {
        "field": "c1_label",
        "title": "Sales（移動平均）"
      },
      {
        "field": "c2_label",
        "title": "Sales"
      },
      {
        "field": "c3_label",
        "title": "Sales（移動總和）"
      }
    ]
  }
}
