{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "usermeta": {
    "worksheet": "ws_orders_by_region",
    "name": "Orders by Region",
    "rows": 3,
    "mark": "text",
    "dimensions": {
      "c0": "f_region"
    },
    "measures": {
      "c1": "countd(f_order_id)"
    },
    "sizing": {
      "rows": {
        "step": 20
      },
      "columns": {
        "size": 49
      }
    },
    "fit": "standard"
  },
  "data": {
    "values": "3 列",
    "fields": [
      "__row",
      "c0",
      "c0_label",
      "c1",
      "c1_label"
    ]
  },
  "width": 49,
  "height": {
    "step": 20
  },
  "autosize": {
    "type": "pad",
    "contains": "padding"
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelLimit": 160
    }
  },
  "mark": {
    "type": "text",
    "tooltip": true,
    "lineBreak": "\n",
    "color": "#1f2328",
    "align": "right",
    "dx": -4,
    "x": {
      "expr": "width"
    }
  },
  "encoding": {
    "y": {
      "field": "c0_label",
      "type": "ordinal",
      "sort": null,
      "title": "Region",
      "axis": {
        "orient": "left",
        "title": "Region",
        "ticks": false,
        "zindex": 1,
        "labelAlign": "left",
        "labelPadding": 52,
        "labelLimit": 48,
        "minExtent": 56,
        "maxExtent": 56,
        "titleAngle": 0,
        "titleAlign": "left",
        "titleBaseline": "bottom",
        "titleX": -52,
        "titleY": -4,
        "titleFontSize": 10,
        "titleFontWeight": 600,
        "titleLimit": 48
      }
    },
    "text": {
      "field": "c1_label",
      "type": "nominal"
    },
    "tooltip": [
      {
        "field": "c0_label",
        "title": "Region"
      },
      {
        "field": "c1_label",
        "title": "CNTD(Order ID)"
      }
    ]
