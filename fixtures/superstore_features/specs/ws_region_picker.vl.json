{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "usermeta": {
    "worksheet": "ws_region_picker",
    "name": "Region Picker",
    "rows": 4,
    "mark": "bar",
    "dimensions": {
      "c0": "f_region"
    },
    "measures": {
      "c1": "sum(f_sales)"
    }
  },
  "data": {
    "values": "4 列",
    "fields": [
      "__row",
      "c0",
      "c0_label",
      "c1",
      "c1_label"
    ]
  },
  "width": "container",
  "height": "container",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelLimit": 160
    }
  },
  "encoding": {
    "x": {
      "field": "c1",
      "type": "quantitative",
      "title": "Sales"
    },
    "y": {
      "field": "c0_label",
      "type": "ordinal",
      "sort": null,
      "title": "Region"
    },
    "tooltip": [
      {
        "field": "c0_label",
        "title": "Region"
      },
      {
        "field": "c1_label",
        "title": "Sales"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "tooltip": true,
        "color": "#4e79a7"
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 10,
        "lineBreak": "\n",
        "align": "left",
        "dx": 3
      },
      "encoding": {
        "text": {
          "field": "c1_label"
        },
        "color": {
          "value": "#1f2328"
        }
      }
    }
  ]
}
