{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "usermeta": {
    "worksheet": "ws_region_sales_bands",
    "name": "Region Sales Bands",
    "rows": 4,
    "mark": "bar",
    "dimensions": {
      "c0": "f_region"
    },
    "measures": {
      "c1": "sum(f_sales)"
    },
    "title_color": "#333333",
    "title_font": {
      "family": "\"Tableau Book\", \"Benton Sans\", \"Segoe UI\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
      "size": 20.0,
      "weight": 400,
      "italic": false
    },
    "sizing": {
      "rows": {},
      "columns": {
        "step": 62,
        "count": 4,
        "fixed": false
      }
    },
    "fit": "standard"
  },
  "data": {
    "values": "4 列",
    "fields": [
      "__ref0_0",
      "__ref1_0",
      "__ref1_1",
      "__row",
      "c0",
      "c0_label",
      "c1",
      "c1_label"
    ]
  },
  "width": "container",
  "height": "container",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "font": "\"Tableau Book\", \"Benton Sans\", \"Segoe UI\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelLimit": 160,
      "labelFont": "\"Tableau Book\", \"Benton Sans\", \"Segoe UI\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
      "labelFontSize": 12.0,
      "labelFontWeight": 400,
      "titleFont": "\"Tableau Book\", \"Benton Sans\", \"Segoe UI\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
      "titleFontSize": 12.0,
      "titleFontWeight": 400,
      "labelColor": "#555555",
      "titleColor": "#333333",
      "gridColor": "#f0f0f0",
      "domainColor": "#f4f4f4",
      "tickColor": "#f4f4f4"
    },
    "legend": {
      "labelFont": "\"Tableau Book\", \"Benton Sans\", \"Segoe UI\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
      "labelFontSize": 12.0,
      "labelFontWeight": 400,
      "titleFont": "\"Tableau Book\", \"Benton Sans\", \"Segoe UI\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
      "titleFontSize": 12.0,
      "titleFontWeight": 600,
      "labelColor": "#555555",
      "titleColor": "#333333"
    },
    "header": {
      "labelFont": "\"Tableau Book\", \"Benton Sans\", \"Segoe UI\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
      "labelFontSize": 12.0,
      "labelFontWeight": 400,
      "titleFont": "\"Tableau Book\", \"Benton Sans\", \"Segoe UI\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
      "titleFontSize": 12.0,
      "titleFontWeight": 400,
      "labelColor": "#555555",
      "titleColor": "#333333"
    },
    "text": {
      "font": "\"Tableau Book\", \"Benton Sans\", \"Segoe UI\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
      "fontSize": 12.0
    }
  },
  "layer": [
    {
      "name": "__ref1_fill0",
      "transform": [
        {
          "aggregate": [
            {
              "op": "max",
              "field": "__ref1_0",
              "as": "__ref1_0"
            },
            {
              "op": "max",
              "field": "__ref1_1",
              "as": "__ref1_1"
            }
          ],
          "groupby": []
        }
      ],
      "mark": {
        "type": "rect",
        "color": "#f6f6f6",
        "tooltip": false
      },
      "encoding": {
        "y": {
          "field": "__ref1_0",
          "type": "quantitative",
          "title": "Sales"
        },
        "y2": {
          "field": "__ref1_1"
        }
      }
    },
    {
      "mark": {
        "type": "bar",
        "tooltip": true,
        "color": "#4e79a7",
        "width": {
          "band": 0.75
        }
      },
      "encoding": {
        "y": {
          "field": "c1",
          "type": "quantitative",
          "title": "Sales",
          "axis": {
            "grid": true,
            "gridColor": {
              "condition": {
                "test": "datum.value === 0",
                "value": "#cbcbcb"
              },
              "value": "#f0f0f0"
            },
            "gridDash": {
              "condition": {
                "test": "datum.value === 0",
                "value": [
                  2,
                  1
                ]
              },
              "value": []
            },
            "gridWidth": {
              "condition": {
                "test": "datum.value === 0",
                "value": 1
              },
              "value": 1
            },
            "tickCount": {
              "expr": "ceil(height / 50)"
            }
          }
        },
        "x": {
          "field": "c0_label",
          "type": "ordinal",
          "sort": null,
          "title": "Region",
          "axis": {
            "ticks": false
          },
          "scale": {
            "type": "band",
            "paddingInner": 0,
            "paddingOuter": 0
          }
        },
        "tooltip": [
          {
            "field": "c0_label",
            "title": "Region"
          },
          {
            "field": "c1_label",
            "title": "Sales"
          }
        ]
      }
    },
    {
      "name": "__ref0_0",
      "mark": {
        "type": "rule",
        "color": "#b4b4b4",
        "strokeWidth": 2
      },
      "encoding": {
        "y": {
          "field": "__ref0_0",
          "type": "quantitative",
          "title": "Sales",
          "aggregate": "max"
        }
      }
    },
    {
      "name": "__ref0_0_label",
      "mark": {
        "type": "text",
        "color": "#555555",
        "align": "left",
        "dx": 3,
        "baseline": "bottom",
        "dy": -3
      },
      "encoding": {
        "y": {
          "field": "__ref0_0",
          "type": "quantitative",
          "title": "Sales",
          "aggregate": "max"
        },
        "x": {
          "value": 0
        },
        "text": {
          "value": "590,011"
        }
      }
    }
  ]
}
