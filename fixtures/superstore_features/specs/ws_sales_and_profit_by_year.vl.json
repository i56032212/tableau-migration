{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "usermeta": {
    "worksheet": "ws_sales_and_profit_by_year",
    "name": "Sales and Profit by Year",
    "rows": 4,
    "mark": "bar+line",
    "dimensions": {
      "c0": "year(f_order_date)"
    },
    "measures": {
      "c1": "sum(f_sales)",
      "c2": "sum(f_profit)"
    },
    "title_color": "#333333",
    "title_font": {
      "family": "\"Tableau Book\", \"Benton Sans\", \"Segoe UI\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
      "size": 20.0,
      "weight": 400,
      "italic": false
    },
    "sizing": {
      "rows": {},
      "columns": {
        "step": 42,
        "count": 4,
        "fixed": false
      }
    },
    "fit": "standard"
  },
  "data": {
    "values": "4 列",
    "fields": [
      "__lid",
      "__row",
      "c0",
      "c0_label",
      "c1",
      "c1_label",
      "c2",
      "c2_label"
    ]
  },
  "width": "container",
  "height": "container",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "font": "\"Tableau Book\", \"Benton Sans\", \"Segoe UI\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelLimit": 160,
      "labelFont": "\"Tableau Book\", \"Benton Sans\", \"Segoe UI\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
      "labelFontSize": 12.0,
      "labelFontWeight": 400,
      "titleFont": "\"Tableau Book\", \"Benton Sans\", \"Segoe UI\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
      "titleFontSize": 12.0,
      "titleFontWeight": 400,
      "labelColor": "#555555",
      "titleColor": "#333333",
      "gridColor": "#f0f0f0",
      "domainColor": "#f4f4f4",
      "tickColor": "#f4f4f4"
    },
    "legend": {
      "labelFont": "\"Tableau Book\", \"Benton Sans\", \"Segoe UI\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
      "labelFontSize": 12.0,
      "labelFontWeight": 400,
      "titleFont": "\"Tableau Book\", \"Benton Sans\", \"Segoe UI\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
      "titleFontSize": 12.0,
      "titleFontWeight": 600,
      "labelColor": "#555555",
      "titleColor": "#333333"
    },
    "header": {
      "labelFont": "\"Tableau Book\", \"Benton Sans\", \"Segoe UI\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
      "labelFontSize": 12.0,
      "labelFontWeight": 400,
      "titleFont": "\"Tableau Book\", \"Benton Sans\", \"Segoe UI\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
      "titleFontSize": 12.0,
      "titleFontWeight": 400,
      "labelColor": "#555555",
      "titleColor": "#333333"
    },
    "text": {
      "font": "\"Tableau Book\", \"Benton Sans\", \"Segoe UI\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
      "fontSize": 12.0
    }
  },
  "layer": [
    {
      "encoding": {
        "y": {
          "field": "c1",
          "type": "quantitative",
          "title": "Sales",
          "axis": {
            "grid": true,
            "gridColor": {
              "condition": {
                "test": "datum.value === 0",
                "value": "#cbcbcb"
              },
              "value": "#f0f0f0"
            },
            "gridDash": {
              "condition": {
                "test": "datum.value === 0",
                "value": [
                  2,
                  1
                ]
              },
              "value": []
            },
            "gridWidth": {
              "condition": {
                "test": "datum.value === 0",
                "value": 1
              },
              "value": 1
            },
            "tickCount": {
              "expr": "ceil(height / 50)"
            }
          }
        },
        "x": {
          "field": "c0_label",
          "type": "ordinal",
          "sort": null,
          "title": "YEAR(Order Date)",
          "axis": {
            "ticks": false
          },
          "scale": {
            "type": "band",
            "paddingInner": 0,
            "paddingOuter": 0
          }
        },
        "tooltip": [
          {
            "field": "c0_label",
            "title": "YEAR(Order Date)"
          },
          {
            "field": "c1_label",
            "title": "Sales"
          },
          {
            "field": "c2_label",
            "title": "Profit"
          }
        ]
      },
      "layer": [
        {
          "mark": {
            "type": "bar",
            "tooltip": true,
            "color": "#4e79a7",
            "width": {
              "band": 0.75
            }
          }
        },
        {
          "name": "__label_c1",
          "mark": {
            "type": "text",
            "font": "\"Tableau Book\", \"Benton Sans\", \"Segoe UI\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
            "fontSize": 12.0,
            "lineBreak": "\n",
            "baseline": "bottom",
            "dy": -3
          },
          "encoding": {
            "text": {
              "condition": {
                "test": "indexof(__label_hidden, datum.__lid) >= 0",
                "value": ""
              },
              "field": "c1_label"
            },
            "color": {
              "value": "#1f2328"
            }
          }
        }
      ]
    },
    {
      "mark": {
        "type": "line",
        "tooltip": true,
        "point": "transparent",
        "color": "#4e79a7",
        "strokeWidth": 2,
        "strokeCap": "round",
        "strokeJoin": "round"
      },
      "encoding": {
        "y": {
          "field": "c2",
          "type": "quantitative",
          "title": "Profit",
          "axis": {
            "grid": true,
            "gridColor": {
              "condition": {
                "test": "datum.value === 0",
                "value": "#cbcbcb"
              },
              "value": "#f0f0f0"
            },
            "gridDash": {
              "condition": {
                "test": "datum.value === 0",
                "value": [
                  2,
                  1
                ]
              },
              "value": []
            },
            "gridWidth": {
              "condition": {
                "test": "datum.value === 0",
                "value": 1
              },
              "value": 1
            },
            "tickCount": {
              "expr": "ceil(height / 50)"
            }
          }
        },
        "x": {
          "field": "c0_label",
          "type": "ordinal",
          "sort": null,
          "title": "YEAR(Order Date)",
          "axis": {
            "ticks": false
          }
        },
        "tooltip": [
          {
            "field": "c0_label",
            "title": "YEAR(Order Date)"
          },
          {
            "field": "c1_label",
            "title": "Sales"
          },
          {
            "field": "c2_label",
            "title": "Profit"
          }
        ]
      }
    }
  ],
  "resolve": {
    "scale": {
      "y": "independent"
    }
  },
  "params": [
    {
      "name": "__label_hidden",
      "value": []
    }
  ]
}
