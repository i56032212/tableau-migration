{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "usermeta": {
    "worksheet": "ws_sales_and_profit_by_year",
    "name": "Sales and Profit by Year",
    "rows": 4,
    "mark": "bar+line",
    "dimensions": {
      "c0": "year(f_order_date)"
    }
  },
  "data": {
    "values": "4 列",
    "fields": [
      "__row",
      "c0",
      "c0_label",
      "c1",
      "c1_label",
      "c2",
      "c2_label"
    ]
  },
  "width": "container",
  "height": "container",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelLimit": 160
    }
  },
  "layer": [
    {
      "encoding": {
        "y": {
          "field": "c1",
          "type": "quantitative",
          "title": "Sales"
        },
        "x": {
          "field": "c0_label",
          "type": "ordinal",
          "sort": null,
          "title": "YEAR(Order Date)"
        },
        "tooltip": [
          {
            "field": "c0_label",
            "title": "YEAR(Order Date)"
          },
          {
            "field": "c1_label",
            "title": "Sales"
          },
          {
            "field": "c2_label",
            "title": "Profit"
          }
        ]
      },
      "layer": [
        {
          "mark": {
            "type": "bar",
            "tooltip": true
          }
        },
        {
          "mark": {
            "type": "text",
            "fontSize": 10,
            "baseline": "bottom",
            "dy": -3
          },
          "encoding": {
            "text": {
              "field": "c1_label"
            },
            "color": {
              "value": "#1f2328"
            }
          }
        }
      ]
    },
    {
      "mark": {
        "type": "line",
        "tooltip": true,
        "point": true
      },
      "encoding": {
        "y": {
          "field": "c2",
          "type": "quantitative",
          "title": "Profit"
        },
        "x": {
          "field": "c0_label",
          "type": "ordinal",
          "sort": null,
          "title": "YEAR(Order Date)"
        },
        "tooltip": [
          {
            "field": "c0_label",
            "title": "YEAR(Order Date)"
          },
          {
            "field": "c1_label",
            "title": "Sales"
          },
          {
            "field": "c2_label",
            "title": "Profit"
          }
        ]
      }
    }
  ],
  "resolve": {
    "scale": {
      "y": "independent"
    }
  }
}
