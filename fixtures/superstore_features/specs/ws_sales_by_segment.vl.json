{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "usermeta": {
    "worksheet": "ws_sales_by_segment",
    "name": "Sales by Segment",
    "rows": 2,
    "mark": "bar",
    "dimensions": {
      "c0": "f_segment"
    },
    "measures": {
      "c1": "sum(f_sales)"
    },
    "sizing": {
      "rows": {
        "step": 20
      },
      "columns": {}
    },
    "fit": "standard"
  },
  "data": {
    "values": "2 列",
    "fields": [
      "__row",
      "c0",
      "c0_label",
      "c1",
      "c1_label"
    ]
  },
  "width": "container",
  "height": {
    "step": 20
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelLimit": 160
    }
  },
  "encoding": {
    "x": {
      "field": "c1",
      "type": "quantitative",
      "title": "Sales"
    },
    "y": {
      "field": "c0_label",
      "type": "ordinal",
      "sort": null,
      "title": "Segment",
      "axis": {
        "ticks": false,
        "zindex": 1,
        "labelAlign": "left",
        "labelPadding": 71,
        "labelLimit": 67,
        "minExtent": 75,
        "maxExtent": 75,
        "title": "Segment",
        "titleAngle": 0,
        "titleAlign": "left",
        "titleBaseline": "bottom",
        "titleX": -71,
        "titleY": -4,
        "titleFontSize": 10,
        "titleFontWeight": 600,
        "titleLimit": 67
      }
    },
    "tooltip": [
      {
        "field": "c0_label",
        "title": "Segment"
      },
      {
        "field": "c1_label",
        "title": "Sales"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "tooltip": true,
        "color": "#4e79a7"
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 10,
        "lineBreak": "\n",
        "align": "left",
        "dx": 3
      },
      "encoding": {
        "text": {
          "field": "c1_label"
        },
        "color": {
          "value": "#1f2328"
        }
      }
    }
  ]
}
