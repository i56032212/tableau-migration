{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "usermeta": {
    "worksheet": "ws_sales_growth_by_year",
    "name": "Sales Growth by Year",
    "rows": 4,
    "mark": "bar",
    "dimensions": {
      "c0": "year(f_order_date)"
    },
    "measures": {
      "c1": "sum(f_sales)#tc_percent_difference_sales",
      "c2": "sum(f_sales)#tc_difference_sales",
      "c3": "sum(f_sales)"
    }
  },
  "data": {
    "values": "4 列",
    "fields": [
      "__row",
      "c0",
      "c0_label",
      "c1",
      "c1_label",
      "c2",
      "c2_label",
      "c3",
      "c3_label"
    ]
  },
  "width": "container",
  "height": "container",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelLimit": 160
    }
  },
  "encoding": {
    "x": {
      "field": "c1",
      "type": "quantitative",
      "title": "Sales（差異百分比）",
      "axis": {
        "format": ".2%"
      }
    },
    "y": {
      "field": "c0_label",
      "type": "ordinal",
      "sort": null,
      "title": "YEAR(Order Date)"
    },
    "tooltip": [
      {
        "field": "c0_label",
        "title": "YEAR(Order Date)"
      },
      {
        "field": "c1_label",
        "title": "Sales（差異百分比）"
      },
      {
        "field": "c2_label",
        "title": "Sales（差異）"
      },
      {
        "field": "c3_label",
        "title": "Sales"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "tooltip": true
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 10,
        "align": "left",
        "dx": 3
      },
      "encoding": {
        "text": {
          "field": "c2_label"
        },
        "color": {
          "value": "#1f2328"
        }
      }
    }
  ]
}
