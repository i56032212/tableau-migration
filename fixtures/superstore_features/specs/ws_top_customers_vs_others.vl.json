{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "usermeta": {
    "worksheet": "ws_top_customers_vs_others",
    "name": "Top Customers vs Others",
    "rows": 2,
    "mark": "bar",
    "dimensions": {
      "c0": "f_top_customers"
    },
    "measures": {
      "c1": "sum(f_sales)",
      "c2": "countd(f_customer_name)"
    }
  },
  "data": {
    "values": "2 列",
    "fields": [
      "__row",
      "c0",
      "c0_label",
      "c1",
      "c1_label",
      "c2",
      "c2_label"
    ]
  },
  "width": "container",
  "height": "container",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelLimit": 160
    }
  },
  "encoding": {
    "x": {
      "field": "c1",
      "type": "quantitative",
      "title": "Sales"
    },
    "y": {
      "field": "c0_label",
      "type": "ordinal",
      "sort": null,
      "title": "IN/OUT(Top Customers)"
    },
    "tooltip": [
      {
        "field": "c0_label",
        "title": "IN/OUT(Top Customers)"
      },
      {
        "field": "c1_label",
        "title": "Sales"
      },
      {
        "field": "c2_label",
        "title": "CNTD(Customer Name)"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "tooltip": true,
        "color": "#4e79a7"
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 10,
        "lineBreak": "\n",
        "align": "left",
        "dx": 3
      },
      "encoding": {
        "text": {
          "field": "c2_label"
        },
        "color": {
          "value": "#1f2328"
        }
      }
    }
  ]
}
