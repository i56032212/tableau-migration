{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "usermeta": {
    "worksheet": "ws_top_customers_vs_others",
    "name": "Top Customers vs Others",
    "rows": 2,
    "mark": "bar",
    "dimensions": {
      "c0": "f_top_customers"
    },
    "measures": {
      "c1": "sum(f_sales)",
      "c2": "countd(f_customer_name)"
    },
    "title_color": "#333333",
    "title_font": {
      "family": "\"Tableau Book\", \"Benton Sans\", \"Segoe UI\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
      "size": 20.0,
      "weight": 400,
      "italic": false
    },
    "sizing": {
      "rows": {
        "step": 20
      },
      "columns": {}
    },
    "fit": "standard"
  },
  "data": {
    "values": "2 列",
    "fields": [
      "__lid",
      "__row",
      "c0",
      "c0_label",
      "c1",
      "c1_label",
      "c2",
      "c2_label"
    ]
  },
  "width": "container",
  "height": {
    "step": 20
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "config": {
    "font": "\"Tableau Book\", \"Benton Sans\", \"Segoe UI\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelLimit": 160,
      "labelSeparation": 4,
      "labelFont": "\"Tableau Book\", \"Benton Sans\", \"Segoe UI\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
      "labelFontSize": 12.0,
      "labelFontWeight": 400,
      "titleFont": "\"Tableau Book\", \"Benton Sans\", \"Segoe UI\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
      "titleFontSize": 12.0,
      "titleFontWeight": 400,
      "labelColor": "#555555",
      "titleColor": "#333333",
      "gridColor": "#f0f0f0",
      "domainColor": "#f4f4f4",
      "tickColor": "#f4f4f4"
    },
    "legend": {
      "labelFont": "\"Tableau Book\", \"Benton Sans\", \"Segoe UI\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
      "labelFontSize": 12.0,
      "labelFontWeight": 400,
      "titleFont": "\"Tableau Book\", \"Benton Sans\", \"Segoe UI\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
      "titleFontSize": 12.0,
      "titleFontWeight": 600,
      "labelColor": "#555555",
      "titleColor": "#333333"
    },
    "header": {
      "labelFont": "\"Tableau Book\", \"Benton Sans\", \"Segoe UI\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
      "labelFontSize": 12.0,
      "labelFontWeight": 400,
      "titleFont": "\"Tableau Book\", \"Benton Sans\", \"Segoe UI\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
      "titleFontSize": 12.0,
      "titleFontWeight": 400,
      "labelColor": "#555555",
      "titleColor": "#333333"
    },
    "text": {
      "font": "\"Tableau Book\", \"Benton Sans\", \"Segoe UI\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
      "fontSize": 12.0
    }
  },
  "encoding": {
    "x": {
      "field": "c1",
      "type": "quantitative",
      "title": "Sales",
      "axis": {
        "grid": true,
        "gridColor": {
          "condition": {
            "test": "datum.value === 0",
            "value": "#cbcbcb"
          },
          "value": "#f0f0f0"
        },
        "gridDash": {
          "condition": {
            "test": "datum.value === 0",
            "value": [
              2,
              1
            ]
          },
          "value": []
        },
        "gridWidth": {
          "condition": {
            "test": "datum.value === 0",
            "value": 1
          },
          "value": 1
        }
      },
      "scale": {
        "domainMax": {
          "expr": "1689720 * width / max(width - 36.6, width / 2)"
        },
        "nice": false
      }
    },
    "y": {
      "field": "c0_label",
      "type": "ordinal",
      "sort": null,
      "title": "IN/OUT(Top Customers)",
      "axis": {
        "ticks": false,
        "zindex": 1,
        "labelFont": "\"Tableau Book\", \"Benton Sans\", \"Segoe UI\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
        "labelFontSize": 12.0,
        "labelFontWeight": 400,
        "labelAlign": "left",
        "labelPadding": 151,
        "labelLimit": 147,
        "minExtent": 155,
        "maxExtent": 155,
        "title": "IN/OUT(Top Customers)",
        "titleAngle": 0,
        "titleAlign": "left",
        "titleBaseline": "bottom",
        "titleX": -151,
        "titleY": -4,
        "titleFont": "\"Tableau Book\", \"Benton Sans\", \"Segoe UI\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
        "titleFontSize": 12.0,
        "titleFontWeight": 600,
        "titleLimit": 147
      },
      "scale": {
        "type": "band",
        "paddingInner": 0,
        "paddingOuter": 0
      }
    },
    "tooltip": [
      {
        "field": "c0_label",
        "title": "IN/OUT(Top Customers)"
      },
      {
        "field": "c1_label",
        "title": "Sales"
      },
      {
        "field": "c2_label",
        "title": "CNTD(Customer Name)"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "tooltip": true,
        "color": "#4e79a7",
        "height": {
          "band": 0.75
        }
      }
    },
    {
      "name": "__label_c1",
      "mark": {
        "type": "text",
        "font": "\"Tableau Book\", \"Benton Sans\", \"Segoe UI\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
        "fontSize": 12.0,
        "lineBreak": "\n",
        "align": "left",
        "dx": 3
      },
      "encoding": {
        "text": {
          "condition": {
            "test": "indexof(__label_hidden, datum.__lid) >= 0",
            "value": ""
          },
          "field": "c2_label"
        },
        "color": {
          "value": "#1f2328"
        }
      }
    }
  ],
  "params": [
    {
      "name": "__label_hidden",
      "value": []
    }
  ]
}
