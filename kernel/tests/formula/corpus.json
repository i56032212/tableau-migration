    {"formula": "[Sales]", "sexpr": "[Sales]"},
    {"formula": "[Sales [USD]]]", "sexpr": "[Sales [USD]]]"},
    {"formula": "[Parameters].[Top N]", "sexpr": "[Parameters].[Top N]"},
    {"formula": "[銷售額]", "sexpr": "[銷售額]"},
    {"formula": "1 + 2 * 3", "sexpr": "(+ 1 (* 2 3))"},
    {"formula": "(1 + 2) * 3", "sexpr": "(* (+ 1 2) 3)"},
    {"formula": "1 - 2 - 3", "sexpr": "(- (- 1 2) 3)"},
    {"formula": "8 / 4 / 2", "sexpr": "(/ (/ 8 4) 2)"},
    {"formula": "7 % 3", "sexpr": "(% 7 3)"},
    {"formula": "2 ^ 3", "sexpr": "(^ 2 3)"},
    {"formula": "-2 ^ 2", "sexpr": "(^ -2 2)"},
    {"formula": "-[Profit] ^ 2", "sexpr": "(^ (- [Profit]) 2)"},
    {"formula": "2 * -[x]", "sexpr": "(* 2 (- [x]))"},
    {"formula": "+[x]", "sexpr": "[x]"},
    {"formula": "[a] = 1", "sexpr": "(= [a] 1)"},
    {"formula": "[a] == 1", "sexpr": "(= [a] 1)"},
    {"formula": "[a] <> 1", "sexpr": "(!= [a] 1)"},
    {"formula": "[a] != 1", "sexpr": "(!= [a] 1)"},
    {"formula": "[a] + 1 >= [b] * 2", "sexpr": "(>= (+ [a] 1) (* [b] 2))"},
    {"formula": "[a] > 1 AND [b] < 2 OR [c]", "sexpr": "(OR (AND (> [a] 1) (< [b] 2)) [c])"},
    {"formula": "[a] OR [b] AND [c]", "sexpr": "(OR [a] (AND [b] [c]))"},
    {"formula": "NOT [a] = 1", "sexpr": "(NOT (= [a] 1))"},
    {"formula": "NOT [a] AND [b]", "sexpr": "(AND (NOT [a]) [b])"},
    {"formula": "not not [a]", "sexpr": "(NOT (NOT [a]))"},
    {"formula": "[Region] IN ('East', 'West')", "sexpr": "(IN [Region] (\"East\" \"West\"))"},
    {"formula": "[x] + 1 in (2, 3) and [y]", "sexpr": "(AND (IN (+ [x] 1) (2 3)) [y])"},
    {"formula": "SUM([Sales])", "sexpr": "(SUM [Sales])"},
    {"formula": "sum([Sales]) / Sum([Quantity])", "sexpr": "(/ (SUM [Sales]) (SUM [Quantity]))"},
    {"formula": "INDEX()", "sexpr": "(INDEX)"},
    {"formula": "IIF([a] > 0, 'pos', 'neg')", "sexpr": "(IIF (> [a] 0) \"pos\" \"neg\")"},
    {"formula": "DATEPART('year', [Order Date])", "sexpr": "(DATEPART \"year\" [Order Date])"},
    {"formula": "WINDOW_SUM(SUM([x]), FIRST(), LAST())", "sexpr": "(WINDOW_SUM (SUM [x]) (FIRST) (LAST))"},
    {"formula": "IF [a] > 0 THEN 'pos' END", "sexpr": "(IF (> [a] 0) \"pos\")"},
    {"formula": "IF [a] > 0 THEN 1 ELSEIF [a] < 0 THEN -1 ELSE 0 END", "sexpr": "(IF (> [a] 0) 1 (< [a] 0) -1 ELSE 0)"},
    {"formula": "if [a] then [b] elseif [c] then [d] end", "sexpr": "(IF [a] [b] [c] [d])"},
