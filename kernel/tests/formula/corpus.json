    {"formula": "case [x] when 1 then 'a' end", "sexpr": "(CASE [x] 1 \"a\")"},
    {"formula": "{FIXED [Region] : SUM([Sales])}", "sexpr": "(FIXED ([Region]) (SUM [Sales]))"},
    {"formula": "{ fixed [Region], [Segment] : SUM([Sales]) }", "sexpr": "(FIXED ([Region] [Segment]) (SUM [Sales]))"},
