    {"formula": "// 只有註解", "error": "公式是空的"},
    {"formula": "'abc", "error": "字串沒有結束"},
    {"formula": "[Sales", "error": "方括號沒有結束"},
    {"formula": "#2024-01-01", "error": "日期常值沒有結束"},
    {"formula": "#Jan 1, 2024#", "error": "無法辨識的日期常值"},
    {"formula": "/* abc", "error": "區塊註解沒有結束"},
    {"formula": "1 +", "error": "公式不完整"},
    {"formula": "SUM([Sales]", "error": "這裡應該是「)」"},
    {"formula": "IF [a] THEN 1", "error": "IF 之後應該接 ELSEIF、ELSE 或 END"},
    {"formula": "IF [a] 1 END", "error": "這裡應該是 THEN"},
    {"formula": "CASE [a] ELSE 1 END", "error": "CASE 至少要有一個 WHEN"},
    {"formula": "{FIXED YEAR([d]) : SUM([x])}", "sexpr": "(FIXED ((YEAR [d])) (SUM [x]))"},
    {"formula": "{FIXED [c], [r]=[Parameters].[P] : COUNTD([a])}", "sexpr": "(FIXED ([c] (= [r] [Parameters].[P])) (COUNTD [a]))"},
    {"formula": "{FIXED [a] SUM([x])}", "error": "這裡應該是「:」"},
    {"formula": "[a] [b]", "error": "多出無法解析的內容"},
    {"formula": "Sales", "error": "不是函式呼叫，也不是關鍵字"},
    {"formula": "1 $ 2", "error": "無法辨識的字元"},
    {"formula": "THEN 1", "error": "這裡不能出現 THEN"}
  ]
